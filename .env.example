# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# Email Configuration (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=info@doappointment.com
EMAIL_HOST_PASSWORD=Zurich@0107
DEFAULT_FROM_EMAIL=info@doappointment.com
ADMIN_NOTIFY_EMAIL=info@doappointment.com

# Country Settings
ALLOWED_COUNTRY_CODE=CH
COUNTRY_HEADER=HTTP_X_COUNTRY_CODE

# Stripe Billing
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
# Get the webhook secret from https://dashboard.stripe.com/webhooks after creating
# an endpoint pointing to https://yourdomain.com/api/billing/webhook/
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Optional: the Stripe Price ID to use when none is passed in the checkout request
# e.g. price_1234567890abcdef (from Stripe Dashboard → Products → <your plan> → Pricing)
STRIPE_DEFAULT_PRICE_ID=price_your_default_price_id_here
