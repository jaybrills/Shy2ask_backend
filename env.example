# Django Settings
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Database (optional: set DB_NAME to use PostgreSQL; otherwise SQLite)
# DB_NAME=shy2ask
# DB_USER=admin
# DB_PASSWORD=0000
# DB_HOST=localhost
# DB_PORT=5432

# Email Configuration (SMTP – used for OTP and notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=info@doappointment.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=info@doappointment.com
ADMIN_NOTIFY_EMAIL=info@doappointment.com

# Security
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://10.0.2.2:8000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# CORS (dev)
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://10.0.2.2:3000,http://localhost:8081,http://127.0.0.1:8081,http://10.0.2.2:8081
# Physical-device LAN regexes can be set if needed:
# CORS_ALLOWED_ORIGIN_REGEXES=^https?://192\\.168\\.\\d{1,3}\\.\\d{1,3}(:\\d+)?$,^https?://10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}(:\\d+)?$,^https?://172\\.(1[6-9]|2\\d|3[0-1])\\.\\d{1,3}\\.\\d{1,3}(:\\d+)?$

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/django.log

# Censor: our model first, then Google API; Google detections saved for training
# CENSOR_USE_OUR_MODEL_FIRST=True
# CENSOR_MODEL_PATH=media/censor_model.joblib
# CENSOR_OUR_MODEL_THRESHOLD=0.6
# OPENAI_API_KEY=sk-...  # primary: text (Moderation, 40+ languages) + image (Vision). Get at https://platform.openai.com/
# CENSOR_OPENAI_VISION_MODEL=gpt-4o-mini  # image content check (any language)
# CENSOR_OPENAI_MODERATION_MODEL=omni-moderation-latest  # best multilingual; leave empty for API default
# PERSPECTIVE_API_KEY=your_key  # fallback; European + other languages (see CENSOR_PERSPECTIVE_LANGUAGES)
# CENSOR_AI_THRESHOLD=0.5  # 0.5 = stricter (all languages); 0.7 = less strict
# CENSOR_SAVE_SAFE_EXAMPLES=False  # optional: save safe examples for balance

# Optional: Stripe, Celery, etc.
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
