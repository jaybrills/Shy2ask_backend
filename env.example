# Django Settings
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (optional: set DB_NAME to use PostgreSQL; otherwise SQLite)
# DB_NAME=shy2ask
# DB_USER=admin
# DB_PASSWORD=0000
# DB_HOST=localhost
# DB_PORT=5432

# Email Configuration (SMTP – used for OTP and notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=info@doappointment.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=info@doappointment.com
ADMIN_NOTIFY_EMAIL=info@doappointment.com

# Security
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/django.log

# Censor: our model first, then Google API; Google detections saved for training
# CENSOR_USE_OUR_MODEL_FIRST=True
# CENSOR_MODEL_PATH=media/censor_model.joblib
# CENSOR_OUR_MODEL_THRESHOLD=0.6
# OPENAI_API_KEY=sk-...  # primary: text (Moderation API) + image (Vision). Get at https://platform.openai.com/
# CENSOR_OPENAI_VISION_MODEL=gpt-4o-mini  # optional; image content check
# PERSPECTIVE_API_KEY=your_key  # fallback if no OpenAI; get at https://developers.perspectiveapi.com/
# CENSOR_AI_THRESHOLD=0.7
# CENSOR_SAVE_SAFE_EXAMPLES=False  # optional: save safe examples for balance

# Optional: Stripe, Celery, etc.
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# CELERY_BROKER_URL=redis://localhost:6379/0
